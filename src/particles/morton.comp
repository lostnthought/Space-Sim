#version 430 core

/**
 * @file morton.comp
 * @brief Computes mortons over each particle in the simulation for LBVH construction.
 * @ingroup particle_group
 */

#define BODY_COUNT 15000
#define MAX_NODES 45000
#define WORKGROUP_SIZE 128

layout (local_size_x = WORKGROUP_SIZE) in;

struct Particle
{
	vec4 p_m;
    vec4 mat;
    vec4 vel;
    vec4 acc;
};

layout(std430, binding=1) buffer ParticleData {

	Particle p_spawn[BODY_COUNT];
	vec4 p_colors[BODY_COUNT];
	uint p_dead[BODY_COUNT];
    uint claimed[BODY_COUNT];
	int nodes_visited[BODY_COUNT];
	uint star_particles[BODY_COUNT];
    Particle p[];
};

struct MortonEntry
{
    uint pid;  
    uint morton;
};

layout(std430, binding=2) buffer MortonData {

    MortonEntry entry[];
};

layout(std430, binding=3) buffer MortonPingData {

    MortonEntry exit[];
};


layout(std430, binding=5) buffer BoundsData {
    uint minx;
    uint miny;
    uint minz;
    uint maxx;
    uint maxy;
    uint maxz;
};
uint expand_bits(uint v)
{
    v = (v * 0x00010001u) & 0xFF0000FFu;
    v = (v * 0x00000101u) & 0x0F00F00Fu;
    v = (v * 0x00000011u) & 0xC30C30C3u;
    v = (v * 0x00000005u) & 0x49249249u;
    return v;
}

uint morton(uint x, uint y, uint z)
{
    return expand_bits(x) | (expand_bits(y) << 1) | (expand_bits(z) << 2);
}
float orderedUintToFloat(uint u)
{
    uint mask = (u & 0x80000000u) != 0u ? 0x80000000u : 0xffffffffu;
    return uintBitsToFloat(u ^ mask);
}
void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= BODY_COUNT) return;

    float mx = orderedUintToFloat(maxx);
    float my = orderedUintToFloat(maxy);
    float mz = orderedUintToFloat(maxz);
    float mix = orderedUintToFloat(minx);
    float miy = orderedUintToFloat(miny);
    float miz = orderedUintToFloat(minz);
    float diffx = max(mx - mix, 1e-6);
    float diffy = max(my - miy, 1e-6);
    float diffz = max(mz - miz, 1e-6);
    float bounds = max(max(diffx, diffy), diffz) * 1.1;

    float cx = (p[i].p_m.x - mix) / bounds;
    float cy = (p[i].p_m.y - miy) / bounds;
    float cz = (p[i].p_m.z - miz) / bounds;

    uint nx = uint(clamp(cx * 1023, 0.0, 1023.0));
    uint ny = uint(clamp(cy * 1023, 0.0, 1023.0));
    uint nz = uint(clamp(cz * 1023, 0.0, 1023.0));
    entry[i].pid = i;
    entry[i].morton = morton(nx, ny, nz);
}

