#version 440
/**
 * @file radix_global.comp
 * @brief Step two of radix sort.
 * @ingroup particle_group
 */
#define WORKGROUP_SIZE 128
#define RADIX_SORT_BINS 128
#define SUBGROUP_SIZE 32
#define ITERATIONS 8

#define BODY_COUNT 15000
#define MAX_NODES 45000
uniform int workgroup_count;
layout (local_size_x = WORKGROUP_SIZE) in;
struct MortonEntry
{
    uint pid;  
    uint morton;
};
layout(std430, binding=2) buffer MortonData {

    MortonEntry entry[];
};
layout(std430, binding=3) buffer MortonPingData {

    MortonEntry exit[];
};

layout(std430, binding=7) buffer RadixData {

    uint local_prefix[5000 * WORKGROUP_SIZE];
    uint local_offsets[BODY_COUNT];
    uint block_bin_count[5000 *RADIX_SORT_BINS];
    uint global_offsets[5000 * RADIX_SORT_BINS];
    uint local_bin_count[5000*RADIX_SORT_BINS];
};

shared uint temp[RADIX_SORT_BINS];
shared uint bin_total[RADIX_SORT_BINS];
shared uint bin_offset[RADIX_SORT_BINS];

void main()
{

    uint id = gl_GlobalInvocationID.x;
    int a = 0;

    if (id >= RADIX_SORT_BINS) return;
    uint sum = 0;
    if (id < RADIX_SORT_BINS)
    {
            
        for (int wg = 0; wg < workgroup_count; wg++) {
            global_offsets[wg * RADIX_SORT_BINS + id] = sum;
            sum += block_bin_count[wg * RADIX_SORT_BINS + id];
        }
        bin_total[id] = sum;
    }
    memoryBarrier();
    barrier();
    if (id == 0 && id < RADIX_SORT_BINS)
    {
        uint running = 0;

        for (int b = 0; b < RADIX_SORT_BINS; b++)
        {
            bin_offset[b] = running;
            running += bin_total[b];
        }
    }
    memoryBarrier();
    barrier();
    if (id < RADIX_SORT_BINS)
    {
        for (int wg = 0; wg < workgroup_count; wg++) {
            global_offsets[wg * RADIX_SORT_BINS + id] += bin_offset[id];
        }   
        
    }

    
}
