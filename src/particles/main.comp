float hash(uint x)
{
    x ^= x >> 16;
    x *= 0x7feb352d;
    x ^= x >> 15;
    x *= 0x846ca68b;
    x ^= x >> 16;
    return float(x) / float(0xffffffffu);
}
vec3 rand_vec(uint id, uint f)
{
    float x = hash(id * 73856093u ^ f);
    float y = hash(id * 19349663u ^ f);
    float z = hash(id * 83492791u ^ f);

    return vec3(x,y,z) * 2.0 - 1.0;
}
