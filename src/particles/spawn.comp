
/**
 * @file spawn.comp
 * @brief Spawns new particles from accretion - unused.
 * @ingroup particle_group
 */
#version 440
layout(local_size_x = 128) in;
uniform int frame;
#define BODY_COUNT 15000
#define MAX_NODES 45000
struct Particle
{
	vec4 p_m;
    vec4 mat;
    vec4 vel;
    vec4 acc;
};
layout(std430, binding=1) buffer ParticleData {

	Particle p_spawn[BODY_COUNT];
	vec4 p_colors[BODY_COUNT];
	uint p_dead[BODY_COUNT];
    uint claimed[BODY_COUNT];
	int nodes_visited[BODY_COUNT];
	uint star_particles[BODY_COUNT];
    Particle p[];
};
struct MortonEntry
{
    uint pid;  
    uint morton;
};
layout(std430, binding=2) buffer MortonData {

    MortonEntry entry[];
};
struct Node {
    vec4 com_m;
    // min and size
    vec4 min;
    // max and next
    vec3 max;
    int next;
    // left child, right child, parent, depth
    ivec4 lrpd;
    // ivec4 next;
};
#define MAX_DEPTH 64
layout(std430, binding=4) buffer NodeData {
    uint ready_queue[MAX_NODES];
    uint children_remaining[MAX_NODES];
    uint depth_offsets[MAX_DEPTH+1];
    uint pad0;
    uint pad1;
    uint pad2;
    vec4 com_m[MAX_NODES];
    vec4 lrsn[MAX_NODES];
    // min and parent
    vec4 nmin[MAX_NODES];
    // max and depth
    vec4 nmax[MAX_NODES];
};
layout(std430, binding=6) buffer NodeCounter {
    uint queue_out;
    int p_dead_cnt;
    int p_spawn_cnt;
    uint star_pcnt;
};
void main()
{
    uint id = gl_GlobalInvocationID.x;
    if (id >= BODY_COUNT || id >= p_spawn_cnt) return;

    int slot = atomicAdd(p_dead_cnt, -1);
    if (slot < 0 || slot >= BODY_COUNT) return;
    p[slot] = p_spawn[id];
    
    
}
