
#version 440
/**
 * @file pos.comp
 * @brief Integrates positions after velocity is computed.
 * @ingroup particle_group
 */
layout(local_size_x = 128) in;
uniform int frame;
#define BODY_COUNT 15000
#define MAX_NODES 45000

struct Particle
{
	vec4 p_m;
    vec4 mat;
    vec4 vel;
    vec4 acc;
};
layout(std430, binding=1) buffer ParticleData {

	Particle p_spawn[BODY_COUNT];
	vec4 p_colors[BODY_COUNT];
	uint p_dead[BODY_COUNT];
    uint claimed[BODY_COUNT];
	int nodes_visited[BODY_COUNT];
	uint star_particles[BODY_COUNT];
    Particle p[];
};

struct Node {
    vec4 com_m;
    // min and size
    vec4 min;
    // max and next
    vec3 max;
    int next;
    // left child, right child, parent, depth
    ivec4 lrpd;
    // ivec4 next;
};
#define MAX_DEPTH 64
layout(std430, binding=4) buffer NodeData {
    uint ready_queue[MAX_NODES];
    uint children_remaining[MAX_NODES];
    uint depth_offsets[MAX_DEPTH+1];
    uint pad0;
    uint pad1;
    uint pad2;
    vec4 com_m[MAX_NODES];
    vec4 lrsn[MAX_NODES];
    // min and parent
    vec4 nmin[MAX_NODES];
    // max and depth
    vec4 nmax[MAX_NODES];
};
layout(std430, binding=6) buffer NodeCounter {
    uint queue_out;
    int p_dead_cnt;
    int p_spawn_cnt;
    uint star_pcnt;
};
struct MortonEntry
{
    uint pid;  
    uint morton;
    // uint64_t key;
};
layout(std430, binding=2) buffer MortonData {

    MortonEntry entry[];
};
// const float DT = 0.05;
uniform float DT;
const vec4 ice = vec4(0.2,0.4,1.0, 1.0);
const vec4 rock = vec4(0.5,0.6,0.3, 1.0);
const vec4 metal = vec4(0.5,0.5,0.6, 1.0);
const vec4 gas = vec4(0.9,0.4,0.2, 1.0);
const float star_threshold = 1000000.0;
void main()
{
    uint id = gl_GlobalInvocationID.x;
    if (id >= BODY_COUNT) return;
    if (p[id].p_m.w >= star_threshold && star_pcnt < 10)
    {
        uint sp = atomicAdd(star_pcnt, 1);
        star_particles[sp] = id; 
    } 
    vec4 material = p[id].mat;
    vec4 color =
          material.x * ice / 4
        + material.y * rock / 4
        + material.z * metal / 4
        + material.w * gas / 4;
    p_colors[id] = color;
    vec4 vel2 = p[id].vel * DT;
    p[id].p_m.x += vel2.x;
    p[id].p_m.y += vel2.y;
    p[id].p_m.z += vel2.z;
    p[id].p_m.xyz = max(p[id].p_m.xyz, vec3(-100000, -100000, -100000));
    p[id].p_m.xyz = min(p[id].p_m.xyz, vec3(100000, 100000, 100000));
    
}
