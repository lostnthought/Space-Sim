#version 460

/**
 * @file indirect.comp
 * @brief Emits a draw command for the generated mesh.
 * @ingroup mesh_group
 */


layout(local_size_x = 1) in;
// layout(binding = 0, offset = 0) uniform atomic_uint vertexCount;

layout(std430, binding = 11) buffer IndirectBuffer {
    uint count;
    uint instanceCount;
    uint first;
    uint baseInstance;
} indirect;

layout(std430, binding=9) buffer DensityData 
{
    float density[];
};
struct Vertex
{
    vec3 pos;
    float pad0;
    vec3 normal;
    float pad1;
    vec3 color;
    float pad2;
};
#define LODMAX 4
#define MAX_CHUNKS 1000
layout(std430, binding=10) buffer DensityVertexData 
{
    int chunk_vertex_offset[MAX_CHUNKS];
    Vertex vertices[];
};
struct VertexInfo
{
    int vcnt;
    uint uid;
    uint pad0;
    uint pad1;
};
layout(std430, binding=12) buffer ChunkData {
    float lod_dist[3];
    uint emitted_chunks;
    VertexInfo vertex_counts[];
};
uniform int chunk_id;
uniform int lod;
uniform int uSize;
uniform bool is_parent;
uniform int chunk_uid;

void main() {
    indirect.count = chunk_vertex_offset[chunk_id];
    if (is_parent)
    {
        uint c = atomicAdd(emitted_chunks, 1);
        vertex_counts[c].vcnt = int(chunk_vertex_offset[chunk_id]);
        vertex_counts[c].uid = chunk_uid;
    }
    indirect.instanceCount = 1;
	int base = ((uSize * uSize * uSize * 15) + ((uSize + 2) * 12 * 6)) * chunk_id;
    indirect.first = base;
    indirect.baseInstance = 0;
}
