#version 440

/**
 * @file marching_cubes.comp
 * @brief Meshes a chunk using marching cubes.
 * @ingroup mesh_group
 */

layout (local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(std140) uniform CameraData {
    vec4 cam_pos;
    vec4 cam_vel;
    mat4 projection;
    mat4 view;
    mat4 inv_projection;
    mat4 inv_view;
};
layout(std430, binding=8) buffer MarchingCubesData 
{
    int EDGE_TO_VERTICES[12][2];
    int EDGE_TABLE[256];
    int TRIANGLE_TABLE[256][16];
};
layout(std430, binding=9) buffer DensityData 
{
    float density[];
};
struct Vertex
{
    vec3 pos;
    float pad0;
    vec3 normal;
    float pad1;
    vec3 color;
    float pad2;
};
#define LODMAX 4
#define MAX_CHUNKS 1000
layout(std430, binding=10) buffer DensityVertexData 
{
    int chunk_vertex_offset[MAX_CHUNKS];
    Vertex vertices[];
};
#define MAX_LAYERS 24

struct WarpLayer
{
    vec3 offset0;
    float freq0;
    vec3 offset1;
    float freq1;
    vec3 offset2;
    float freq2;
    float amp;
    float pad0;
    float pad1;
    float pad3;
};

struct PerlinLayer
{
    float freq;
    float amp;
    float pad0;
    float pad1;
};
    
struct FBMLayer
{
    float freq;
    float amp;
    float pad0;
    float pad1;
};
    
layout(std430, binding=13) buffer PlanetData {

    int warp_count;
    int perlin_count;
    int fbm_count;
    int pad0;
    vec4 sun_dir;
    vec4 sun_color;
    WarpLayer warp_layers[MAX_LAYERS];
    PerlinLayer perlin_layers[MAX_LAYERS];
    FBMLayer fbm_layers[MAX_LAYERS];

};

const vec3 delta[8] =
{
    vec3(0, 0, 0),
    vec3(1, 0, 0),
    vec3(1, 0, 1),
    vec3(0, 0, 1),
    vec3(0, 1, 0),
    vec3(1, 1, 0),
    vec3(1, 1, 1),
    vec3(0, 1, 1)
};

const float ISO_VALUE = 0.0;
uniform int uSize;
uniform vec3 chunk_offset;
uniform int chunk_id;
uniform sampler3D perlin_tex;
uniform sampler3D fbm_tex;

#define NUM_OCTAVES 5
float mod289(float x){return x - floor(x * (1.0 / 289.0)) * 289.0;}
vec4 mod289(vec4 x){return x - floor(x * (1.0 / 289.0)) * 289.0;}
vec4 perm(vec4 x){return mod289(((x * 34.0) + 1.0) * x);}

float noise(vec3 p){
    vec3 a = floor(p);
    vec3 d = p - a;
    d = d * d * (3.0 - 2.0 * d);

    vec4 b = a.xxyy + vec4(0.0, 1.0, 0.0, 1.0);
    vec4 k1 = perm(b.xyxy);
    vec4 k2 = perm(k1.xyxy + b.zzww);

    vec4 c = k2 + a.zzzz;
    vec4 k3 = perm(c);
    vec4 k4 = perm(c + 1.0);

    vec4 o1 = fract(k3 * (1.0 / 41.0));
    vec4 o2 = fract(k4 * (1.0 / 41.0));

    vec4 o3 = o2 * d.z + o1 * (1.0 - d.z);
    vec2 o4 = o3.yw * d.x + o3.xz * (1.0 - d.x);

    return o4.y * d.y + o4.x * (1.0 - d.y);
}


float fbm(vec3 x) {
	float v = 0.0;
	float a = 0.5;
	// float f = 1.0;
	vec3 shift = vec3(100);
	for (int i = 0; i < NUM_OCTAVES; ++i) {
		v += a * noise(x);
		x = x * 2.0 + shift;
		// f *= 2.5;
		a *= 0.45;
	}
	return v;
}

float density_fn(vec3 p)
{
    
    float d = p.z;
    for (int i = 0; i < warp_count; i++)
    {
        
        WarpLayer wl = warp_layers[i];
        vec3 warp = 
            vec3(texture(perlin_tex, p * wl.freq0 + wl.offset0).r * 2.0f - 1.0f,
            texture(perlin_tex, p * wl.freq1 + wl.offset1).r * 2.0f - 1.0f,
            texture(perlin_tex, p * wl.freq2 + wl.offset2).r * 2.0f - 1.0f);
        p += warp * wl.amp;
    }

    for (int i = 0; i < perlin_count; i++)
    {
        PerlinLayer pl = perlin_layers[i];
        d += (float(texture(perlin_tex, p * pl.freq).r) * 2.0f - 1.0f) * pl.amp;
    }
    for (int i = 0; i < fbm_count; i++)
    {
        FBMLayer fl = fbm_layers[i];
        d += (float(texture(fbm_tex, p * fl.freq).r) * 2.0f - 1.0f) * fl.amp;
    }
    return d;
}

uint density_index(uvec3 p, uint padded)
{

    return p.z * padded * padded + p.y * padded + p.x + padded * padded * padded * chunk_id;
}


float lookup_density(uvec3 p, uint padded)
{
    
    return density[density_index(uvec3(p.x, p.y, p.z), padded)];
}

float sample_density(vec3 p, vec3 chunk_offset, vec3  center_offset, float voxel_size, uint padded)
{
    vec3 grid = (p - chunk_offset - center_offset) / voxel_size;

    uvec3 i = uvec3(floor(grid));
    vec3 f = fract(grid);
    uvec3 i1 = uvec3(i + 1);
    if (i.x < 0 || i.x > uSize || i.y < 0 || i.y > uSize || i.z < 0 || i.z > uSize || i1.x < 0 || i1.x > uSize || i1.y < 0 || i1.y > uSize || i1.z < 0 || i1.z > uSize) return density_fn(p);

    uvec3 p0 = uvec3(i.x, i.y, i.z);
    uvec3 p1 = uvec3(i1.x, i.y, i.z);
    uvec3 p2 = uvec3(i.x, i1.y, i.z);
    uvec3 p3 = uvec3(i1.x, i1.y, i.z);
    uvec3 p4 = uvec3(i.x, i.y, i1.z);
    uvec3 p5 = uvec3(i1.x, i.y, i1.z);
    uvec3 p6 = uvec3(i.x, i1.y, i1.z);
    uvec3 p7 = uvec3(i1.x, i1.y, i1.z);

    float c000 = lookup_density(p0, padded);
    float c100 = lookup_density(p1, padded);
    float c010 = lookup_density(p2, padded);
    float c110 = lookup_density(p3, padded);
    float c001 = lookup_density(p4, padded);
    float c101 = lookup_density(p5, padded);
    float c011 = lookup_density(p6, padded);
    float c111 = lookup_density(p7, padded);

    float c00 = mix(c000, c100, f.x);
    float c10 = mix(c010, c110, f.x);
    float c01 = mix(c001, c101, f.x);
    float c11 = mix(c011, c111, f.x);

    float c0 = mix(c00, c10, f.y);
    float c1 = mix(c01, c11, f.y);

    return mix(c0, c1, f.z);
}

vec3 check_bounds(vec3 p, vec3 min, vec3 max)
{
    vec3 b = vec3(0,0,0);
    if (p.x <= min.x + 0.1) b.x = -1;
    if (p.x >= max.x - 0.1) b.x = 1;
    if (p.y <= min.y + 0.1) b.y = -1;
    if (p.y >= max.y - 0.1) b.y = 1;
    if (p.z <= min.z + 0.1) b.z = -1;
    if (p.z >= max.z - 0.1) b.z = 1;

    return b;
}


/**<@see https://developer.nvidia.com/gpugems/gpugems3/part-i-geometry/chapter-1-generating-complex-procedural-terrains-using-gpu*/
void main()
{

    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    uint z = gl_GlobalInvocationID.z;
    if (x >= uSize || y >= uSize || z >= uSize) return;
    float chunk_world_size = 20;

    float voxel_size = chunk_world_size / uSize;

    vec3 center_offset = vec3(-0.5 * chunk_world_size);
    vec3 p = vec3(x, y, z) * voxel_size + center_offset + chunk_offset;
    vec3 min = center_offset + chunk_offset;
    vec3 max = min + vec3(chunk_world_size);

    vec3 points[8];
    vec3 verts[12];
    float vals[8];
    vec3 normals[12];
    bool point_on_border[8];
    bool vert_on_border[12];
    vec3 point_perp_normals[8];
    vec3 vert_perp_normals[12];
    uint val = 0;
    uint padded = uSize + 1;

    for (uint i = 0; i < 8; i++)
    {
        points[i] = p + delta[i] * voxel_size;
        uint xi = x + uint(delta[i].x);
        uint yi = y + uint(delta[i].y);
        uint zi = z + uint(delta[i].z);
        vals[i] = density[zi * padded * padded + yi * padded + xi + padded * padded * padded * chunk_id];

        if (vals[i] > ISO_VALUE) {
            val = val | (1u << i);
        }
    	verts[i] = points[i];
    	vert_on_border[i] = point_on_border[i];
    }

    uint edge = EDGE_TABLE[val];

    float d = voxel_size;
    for (uint i = 0; i < 12; i++)
	{
		if ((edge & (1u << i)) != 0)
		{
			int a = EDGE_TO_VERTICES[i][0];
			int b = EDGE_TO_VERTICES[i][1];

			float T = (ISO_VALUE - vals[a]) / (vals[b] - vals[a]);
			verts[i] = points[a] + (points[b] - points[a]) * T;
			// if edge vertex, lookup density
            vec3 normal_a;
            float x0 = sample_density(verts[i] + vec3(d, 0, 0), center_offset, chunk_offset, voxel_size, padded);
            float x1 = sample_density(verts[i] + vec3(-d, 0, 0), center_offset, chunk_offset, voxel_size, padded);
            float y0 = sample_density(verts[i] + vec3(0, d, 0), center_offset, chunk_offset, voxel_size, padded);
            float y1 = sample_density(verts[i] + vec3(0, -d, 0), center_offset, chunk_offset, voxel_size, padded);
            float z0 = sample_density(verts[i] + vec3(0, 0, d), center_offset, chunk_offset, voxel_size, padded);
            float z1 = sample_density(verts[i] + vec3(0, 0, -d), center_offset, chunk_offset, voxel_size, padded);
            normal_a.x = x0 - x1;
            normal_a.y = y0 - y1;
            normal_a.z = z0 - z1;

            normals[i] = normalize(normal_a);
		}
	}    

    int tcnt = 0;
	int next_vertex = TRIANGLE_TABLE[val][tcnt++];
	int base = ((uSize * uSize * uSize * 15) + ((uSize + 2) * 12 * 6)) * chunk_id;
	float skirt_length = 3;
	for (int i = 0; i < 5; i++)
	{

	    if(next_vertex == -1) break;
	    int border_verts[3];
	    int bv_count = 0;
        int vcnt = atomicAdd(chunk_vertex_offset[chunk_id], 3);
        vcnt += base;
    	
        vertices[vcnt].pos = verts[next_vertex];
        if (vert_on_border[next_vertex])
        {
            border_verts[bv_count++] = next_vertex;
        }
        vertices[vcnt].normal = normals[next_vertex];

    	next_vertex = TRIANGLE_TABLE[val][tcnt++];

        vertices[vcnt+1].pos = verts[next_vertex];
        vertices[vcnt+1].normal = normals[next_vertex];
        if (vert_on_border[next_vertex])
        {
            border_verts[bv_count++] = next_vertex;
        }
        
    	next_vertex = TRIANGLE_TABLE[val][tcnt++];

        vertices[vcnt+2].pos = verts[next_vertex];
        vertices[vcnt+2].normal = normals[next_vertex];
        if (vert_on_border[next_vertex])
        {
            border_verts[bv_count++] = next_vertex;
        }

    	next_vertex = TRIANGLE_TABLE[val][tcnt++];

    	
    	if (next_vertex == -1) break;
	}
    
}
