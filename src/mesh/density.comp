#version 460

/**
 * @file density.comp
 * @brief Creates a density field from a chunk.
 * @ingroup mesh_group
 */

layout (local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
// layout (local_size_y = 64) in;
// layout (local_size_z = 64) in;
layout(std140) uniform CameraData {
    vec4 cam_pos;
    vec4 cam_vel;
    mat4 projection;
    mat4 view;
    mat4 inv_projection;
    mat4 inv_view;
};
layout(std430, binding=8) buffer MarchingCubesData 
{
    int EDGE_TO_VERTICES[12][2];
    int EDGE_TABLE[256];
    int TRIANGLE_TABLE[256][16];
};
layout(std430, binding=9) buffer DensityData 
{
    float density[];
};
struct Vertex
{
    vec3 pos;
    float pad0;
    vec3 normal;
    float pad1;
    vec3 color;
    float pad2;
};
#define LODMAX 4
#define MAX_CHUNKS 400

struct VertexInfo
{
    int vcnt;
    uint uid;
    uint pad0;
    uint pad1;
};
layout(std430, binding=12) buffer ChunkData {
    float lod_dist[3];
    uint emitted_chunks;
    VertexInfo vertex_counts[];
};
#define MAX_LAYERS 24

struct WarpLayer
{
    vec3 offset0;
    float freq0;
    vec3 offset1;
    float freq1;
    vec3 offset2;
    float freq2;
    float amp;
    float pad0;
    float pad1;
    float pad3;
};

struct PerlinLayer
{
    float freq;
    float amp;
    float pad0;
    float pad1;
};
    
struct FBMLayer
{
    float freq;
    float amp;
    float pad0;
    float pad1;
};
    
layout(std430, binding=13) buffer PlanetData {

    int warp_count;
    int perlin_count;
    int fbm_count;
    int pad0;
    vec4 sun_dir;
    vec4 sun_color;
    WarpLayer warp_layers[MAX_LAYERS];
    PerlinLayer perlin_layers[MAX_LAYERS];
    FBMLayer fbm_layers[MAX_LAYERS];

};
layout(std430, binding=10) buffer DensityVertexData 
{
    int chunk_vertex_offset[MAX_CHUNKS];
    Vertex vertices[];
};
layout(std430, binding=6) buffer NodeCounter {
    uint queue_out;
    int p_dead_cnt;
    int p_spawn_cnt;
    uint star_pcnt;
};

#define NUM_OCTAVES 5
float mod289(float x){return x - floor(x * (1.0 / 289.0)) * 289.0;}
vec4 mod289(vec4 x){return x - floor(x * (1.0 / 289.0)) * 289.0;}
vec4 perm(vec4 x){return mod289(((x * 34.0) + 1.0) * x);}

float noise(vec3 p){
    vec3 a = floor(p);
    vec3 d = p - a;
    d = d * d * (3.0 - 2.0 * d);

    vec4 b = a.xxyy + vec4(0.0, 1.0, 0.0, 1.0);
    vec4 k1 = perm(b.xyxy);
    vec4 k2 = perm(k1.xyxy + b.zzww);

    vec4 c = k2 + a.zzzz;
    vec4 k3 = perm(c);
    vec4 k4 = perm(c + 1.0);

    vec4 o1 = fract(k3 * (1.0 / 41.0));
    vec4 o2 = fract(k4 * (1.0 / 41.0));

    vec4 o3 = o2 * d.z + o1 * (1.0 - d.z);
    vec2 o4 = o3.yw * d.x + o3.xz * (1.0 - d.x);

    return o4.y * d.y + o4.x * (1.0 - d.y);
}


float fbm(vec3 x) {
	float v = 0.0;
	float a = 0.5;
	vec3 shift = vec3(100);
	for (int i = 0; i < NUM_OCTAVES; ++i) {
		v += a * noise(x);
		x = x * 2.0 + shift;
		a *= 0.45;
	}
	return v;
}

const float radius = 1000.0;

uniform int uSize;
uniform int lod;
uniform vec3 chunk_offset;
uniform sampler3D perlin_tex;
uniform sampler3D fbm_tex;

uniform int chunk_id;
/**<@see https://developer.nvidia.com/gpugems/gpugems3/part-i-geometry/chapter-1-generating-complex-procedural-terrains-using-gpu*/
void main()
{

    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    uint z = gl_GlobalInvocationID.z;
    if (x >= uSize+1 || y >= uSize+1 || z >= uSize+1) return;
    if (x == 0 && y == 0  && z == 0)
    {
        chunk_vertex_offset[chunk_id] = 0;
    }
    float chunk_world_size = 20; 

    float voxel_size = chunk_world_size / uSize;

    vec3 center_offset = vec3(-0.5 * chunk_world_size);
    vec3 p = center_offset + vec3(x,y,z) * voxel_size + chunk_offset;
    float d = (p.z);
    vec3 nn = p;
    for (int i = 0; i < warp_count; i++)
    {
        
        WarpLayer wl = warp_layers[i];
        vec3 warp = 
            vec3(texture(perlin_tex, p * wl.freq0 + wl.offset0).r * 2.0f - 1.0f,
            texture(perlin_tex, p * wl.freq1 + wl.offset1).r * 2.0f - 1.0f,
            texture(perlin_tex, p * wl.freq2 + wl.offset2).r * 2.0f - 1.0f);
        p += warp * wl.amp;
    }

    for (int i = 0; i < perlin_count; i++)
    {
        PerlinLayer pl = perlin_layers[i];
        d += (float(texture(perlin_tex, p * pl.freq).r) * 2.0f - 1.0f) * pl.amp;
    }
    for (int i = 0; i < fbm_count; i++)
    {
        FBMLayer fl = fbm_layers[i];
        d += (float(texture(fbm_tex, p * fl.freq).r) * 2.0f - 1.0f) * fl.amp;
    }
    density[z * (uSize + 1) * (uSize+ 1) + y * (uSize+1) + x +
        (uSize+1) * (uSize+1) * (uSize+1) * chunk_id] = d;
    
}
